{% extends "_base.jinja" %}

{% block scripts %}
    <script defer="defer"
        src="/static/js/utils-ajax.js"></script>
    <script defer="defer"
        src="/static/js/ajout-compte.js"></script>
{% endblock %}

{% block contenu %}
    <section>
        <div class = "row justify-content-center">
            <form method="POST" id="formCompte" "action="/api/creer-compte-rapide" class="col-6 border border-primary border-2 rounded-4 p-4 mt-4">
                <div class="mt-3">
                    <label class="form-label">Courriel :</label>
                    <input name="courriel" id="courriel_utilisateur" class="form-control {% if message_courriel %}is-invalid{% endif %}" value="{{courriel}}"/>
                    <p class="text-danger", id="message_courriel"></p>
                </div>
                <div class="mt-3">
                    <label class="form-label mt-3">Mot de passe :</label>
                    <input type="password" name="mdp" id="mot_de_passe" class="form-control {% if message_mdp %}is-invalid{% endif %}"/>
                </div>
                <div class="mt-3">
                    <label class="form-label mt-3">Confirmer le mot de passe :</label>
                    <input type="password" name="conf_mdp" class="form-control {% if message_conf_mdp %}is-invalid{% endif %}"/>
                    <p class="text-danger">{{message_conf_mdp}}</p>
                </div>
                <div class="text-center">
                    <button type="submit" onclick="ajout_compte" class="btn btn-primary text-white mt-3">Créer un compte</button>
                </div>
            </form>
        </div>
    </section>
{% endblock %}


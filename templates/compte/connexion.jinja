{% extends "_base.jinja" %}

{% block contenu %}
    <section>
       <div class = "row justify-content-center">
            <form method="POST" action="{{url_for('comptes.connexion')}}" class="col-6 border border-primary border-2 rounded-4 p-4 mt-4">
                <div class="mt-3">
                    <label class="form-label">Courriel :</label>
                    <input name="courriel" class="form-control {% if erreur_courriel %}is-invalid{% endif %}" value="{{courriel}}"/>
                    <p class="text-danger">{{msg_courriel_vide}}</p>
                    <p class="text-danger">{{msg_courriel_regex}}</p>           
                    
                </div>
                <div class="mt-3">
                    <label class="form-label mt-3">Mot de passe :</label>
                    <input type="password" name="mdp" class="form-control {% if erreur_mdp %}is-invalid{% endif %}"></input>
                    <p class="text-danger">{{msg_mdp_vide}}</p>
                    <p class="text-danger">{{msg_mdp_regex}}</p>
                </div>
                <div class="text-center">
                    <p class="text-danger">{{msg_inexistant}}</p>
                    <button type="submit" class="btn btn-primary text-white mt-3">Se connecter</button>
                </div>
            </form>
        </div>
    </section>


{% endblock %}
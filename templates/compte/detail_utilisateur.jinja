{% extends "_base.jinja" %}

{% block contenu %}
   <div class="row justify-content-center  container mt-5">
        <div class="col-md-4">
            <img src="/static/image/image_utilisateur.png" class="w-75" alt="Image Utilisateur">
            <h3 class="mt-3"> {{courriel}}</h3>
            <p class ='fs-4 mt-2'>{{credit}} $ de crédit</p>
        </div>
        <div class="col-md-8 justify-content-center">

            <h2 class='text-center mt-4'>Liste des cartes</h2>
            <div class="d-flex flex-wrap gap-1 justify-content-center mt-5">
                {%if cartes|length == 0%}
                    <div class="text-center">
                        <img src="/static/image/iconeVide.png" alt= "Collection Vide" class="w-25"/>
                        <p class ="fs-6 mt-3"> La collection est vide 🥀</p>
                        <p class="mt-2">Ajouter des cartes pour démarrer votre collection </p>
                    </div>
                {% else %}
                    {%for ligne in cartes %}
                        <div class="card" style="width: 16rem;">
                            <img src="{{ligne["photo"]}}" class="card-img-top" alt="Image Pokemon">
                            <div class="card-body">
                                <h5 class="card-title">{{ligne["name"]}}</h5>
                            </div>
                            <ul class="list-group list-group-flush">            
                                {% if ligne["types"] is not none %}
                                    <li class="list-group-item">Type : {{ ligne.types | replace("[", "") | replace("]", "") | replace("'", "") }}</li>
                                {% else %}
                                    <li class="list-group-item"> SuperType : {{ ligne.supertype }}</li>
                                {% endif %}
                                {% if ligne["set_num"] is not none %}
                                    <li class="list-group-item">Valeur : {{ ligne.set_num }}</li>
                                {% endif %}
                                {% if ligne["rarity"] is not none %}
                                    <li class="list-group-item">Rareté : {{ ligne.rarity }}</li>
                                {% endif %}

                            </ul>
                            <form method="POST" action="{{ url_for('collection.afficher_detail') }}"  class="list-group-item text-center">
                                    <input type="hidden" name="id_pokemon" value="{{ ligne['id'] }}">
                                    <button type="submit" class="btn btn-primary mt-1 mb-1">Afficher les détails</button>
                            </form>
                            
                        </div>
                    {%endfor%}
                {%endif%}
            </div>
        </div>
   </div>
   
   

{% endblock %}

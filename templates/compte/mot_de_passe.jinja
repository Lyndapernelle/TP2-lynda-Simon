{% extends "_base.jinja" %}

{% block contenu %}
<div class = "row justify-content-center">
    <form method="POST" action="{{url_for('comptes.changer_mdp')}}" class="col-6 border border-primary border-2 rounded-4 p-4 mt-4">
        <div class="mt-3">
            <label class="form-label">Mot de passe actuel :</label>
            <input type="password" name="mdp_actuel" class="form-control {% if valide_mdp %}is-invalid{% endif %}"/>
                <p class="text-danger">{{msg_mdp_invalide}}</p>
                <p class="text-danger">{{msg_mdp_vide}}</p>  
        </div>
        <div class="mt-3">
             <label class="form-label mt-3">Nouveau mot de passe :</label>
            <input type="password" name="nouveau_mdp" class="form-control {% if nouv_mdp %}is-invalid{% endif %}"></input>
            <p class="text-danger">{{msg_mdp_regex}}</p>
            <p class="text-danger">{{msg_mdp_vide}}</p>
        </div>

        <div class="mt-3">
            <label class="form-label mt-3">Confirmer le nouveau mot de passe :</label>
            <input type="password" name="nouveau_mdp_conf" class="form-control {% if nouv_mdp_conf %}is-invalid{% endif %}"></input>
            <p class="text-danger">{{msg_mdp_pas_pareil}}</p>
        </div>
        <div class="text-center">
            <button type="submit" class="btn btn-primary text-white mt-3">Se connecter</button>
        </div>
    </form>
</div>

{% endblock%}
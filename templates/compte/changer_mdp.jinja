{% extends "_base.jinja" %}

{% block contenu %}
    <section>
        <div class = "row justify-content-center">
            <form method="POST" action="{{url_for('comptes.changer_mot_passe')}}" class="col-6 border border-primary border-2 rounded-4 p-4 mt-4">
                <div class="mt-3">
                    <label class="form-label">Mot de passe actuel :</label>
                    <input name="mdp" class="form-control {% if message_mdp %}is-invalid{% endif %}" "/>
                    <p class="text-danger">{{message_mdp}}</p>
                </div>
                <div class="mt-3">
                    <label class="form-label mt-3">Nouveau mot de passe :</label>
                    <input type="password" name="nouv_mdp" class="form-control {% if message_nouv_mdp %}is-invalid{% endif %}"/>
                    <p class="text-danger">{{message_nouv_mdp}}</p>
                </div>
                <div class="mt-3">
                    <label class="form-label mt-3">Confirmer le mot de passe :</label>
                    <input type="password" name="conf_mdp" class="form-control {% if message_conf_mdp %}is-invalid{% endif %}"/>
                    <p class="text-danger">{{message_conf_mdp}}</p>
                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary text-white mt-3">Changer le mot de passe </button>
                </div>
            </form>
        </div>
    </section>


{% endblock %}
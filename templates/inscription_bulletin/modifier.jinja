{% extends "_base.jinja" %}

{% block contenu %}
    <div class="container">
        <form action="{{ url_for('inscription.modifier') }}" method="GET" class="row align-items-center justify-content-center mt-4">
            <div class="mb-4 col-md-8">
                <label for="courriel" class="form-label">Courriel</label>
                <input type="text" name="courriel" id="courriel" class="form-control w-75">
                <p class="text-danger">{{message_erreur_courriel}}</p>
            </div>
            <div class="col-md-4 ms-3">
                <button type="submit" class="btn btn-primary">Rechercher</button>
            </div>
        </form>
    </div>
{% endblock %}
{% extends "_base.jinja" %}

{% block scripts %}
    <script defer="defer" src="/static/js/utils-ajax.js"></script>
    <script defer="defer" src="/static/js/recherche-accueil.js"></script>
{% endblock %}


{% block contenu %}
    <div class="row align-items-center justify-content-center mt-4">
        <form class="d-flex justify-content-center mt-4 col-md-4 align-items-center position-relative" method = 'GET' id='form_recherche'>
            <label for="nom_pokemon" class="form-label me-3">Nom du Pokemon :</label>
            <input type="text" name="nom_pokemon" id="nom_pokemon" class="form-control w-50 bg-white border border-2 border-primary rounded-3"/>
            <div id="div-suggestions" class="suggestions"></div>
        </form>
        {% if 'courriel' in session%}  
            <form method="GET" class="d-flex justify-content-center mt-4 col-md-4"  action="{{ url_for('index') }}">
                <select name="statut" class="form-select w-auto me-4 bg-white border border-2 border-primary rounded-3">
                    <option value="">Tous les statuts</option>
                    <option value="disponible" {% if statut == 'disponible' %}selected{% endif %}>Disponible</option>
                    <option value="recherchée" {% if statut == 'recherchée' %}selected{% endif %}>Recherchée</option>
                </select>

                <button type="submit" class="btn btn-primary ms-4">Appliquer</button>
            </form>
        {%endif%}
    </div>
    <div class="d-flex flex-wrap gap-3 justify-content-center mt-5" id="liste-pokemon">
        {%if lesPokemons|length == 0 %}
                <div class="text-center">
                    <img src="../static/image/iconeVide.png" alt= "Aucun résultat" class="w-25"/>
                    <p class ="fs-2 fw-bold mt-3"> Aucun résultat  🥀</p>     
                </div>
        {% else %}
            {%for ligne in lesPokemons %}
                <div class="card" style="width: 17rem;">
                    <img src="{{ligne["photo"]}}" class="card-img-top" alt="Image Pokemon">
                    <div class="card-body">
                        <h5 class="card-title">{{ligne["name"]}}</h5>
                    </div>
                    <ul class="list-group list-group-flush">            
                        {% if ligne["types"] is not none %}
                            <li class="list-group-item">Type : {{ ligne["types"] | replace("[", "") | replace("]", "") | replace("'", "") }}</li>
                        {% endif %}
                        {% if ligne["set_num"] is not none %}
                            <li class="list-group-item">Valeur : {{ ligne["set_num"] }}</li>
                        {% endif %}
                        {% if ligne["rarity"] is not none %}
                            <li class="list-group-item">Rareté : {{ ligne["rarity"] }}</li>
                        {% endif %}
                        {% if ligne["condition"] is not none %}
                            <li class="list-group-item"> Condition : {{ ligne["condition"] }}</li>
                        {% endif%}                        
                        {% if ligne["cost"] is not none %}
                            <li class="list-group-item"> Coût : {{ ligne["cost"] }} </li>
                        {% endif %}
                        {% if ligne["status"] is not none %}
                            <li class="list-group-item"> Status : {{ ligne["status"] }} </li>
                        {% endif %}
                        
                    </ul>
                    <div class='d-flex justify-content-center align-items-center gap-3'>
                        <form method="GET" class="mt-3" action="{{ url_for('collection.afficher_detail',coll_id = ligne["id"]) }}">
                            <button type="submit" class="btn btn-primary btn-sm mt-1 mb-1 rounded-pill">Afficher les détails</button>
                        </form>
                        {% if (session["courriel"] == 'admin@garneau.ca' or session['id'] != ligne["id_collectionneur"]) and ligne["status"] == 'disponible'%}
                            <form method="GET" class="mt-3" action="{{url_for('collection.ajout_offre', id_item = ligne['id']) }}">
                                <button type="submit" class="btn btn-primary btn-sm mt-1 mb-1 rounded-pill">Faire une offre pour la carte</button> 
                            </form>
                        {% endif %}
                    </div>
                </div>
            {%endfor%}
        {%endif%}
    </div>
{% endblock %}
<!DOCTYPE html>
<html lang="fr">

<head>
    <title>Gabarit TP Web 3</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="https://www.cegepgarneau.ca/favicon.ico">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg py-4" style="background-color:#0b367e;">
            <div class="container">
                <a class="navbar-brand text-white fw-bold fs-1" href="/">
                    Pokémon TCG Collection
                </a>
                <div class="d-flex gap-2">
                    <a class="btn btn-warning rounded-pill px-4" href="/collection/recherche">
                        Ajouter une carte
                    </a>
                    <a class="btn btn-warning rounded-pill px-4" href="/collection/page_collection">
                        Votre collection
                    </a>
                    <a class="btn btn-warning rounded-pill px-4" href="/compte/connexion">
                        Se connecter
                    </a>           
                </div>
            </div>
        </nav>
    </header>
    <main class="bg-white container mt-5">
        <h2 class="d-flex justify-content-center mb-3">{{ titre | default("Accueil") }} | Pokémon TCG Collection</h2>

        {% block contenu %}
            <p>Voici une valeur par défaut</p>
        {% endblock %}

    </main>

    <footer>
        <div class="d-flex container flex-row p-2 justify-content-between">
            <p class="p-2 fw-3 fs-4 text-black">Auteurs : Simon Bolduc, Lynda Folac</p>
            <a class="p-2 text-black" href="https://jinja.palletsprojects.com/en/stable/templates/" target="_blank" title="jinja.palletsprojects.com">
                Documentation officielle de Jinja
            </a>
        </div>
    </footer>
</body>
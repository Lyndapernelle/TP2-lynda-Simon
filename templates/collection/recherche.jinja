{% extends "_base.jinja" %}

{% block contenu %}
    <div class="container">
        <form action="{{ url_for('collection.recherche') }}" method="GET" class="row align-items-center justify-content-center mt-4">
            <div class="col-md-4 ">
                <div class="mb-4">
                    <label for="nom_pokemon" class="form-label">Nom du Pokemon :</label>
                    <input type="text" name="nom_pokemon" id="nom_pokemon" class="form-control w-75">
                </div>
                <div>
                    <label for="numero" class="form-label">Numero du Pokemon :</label>
                    <input type="number" name="numero" id="numero" class="form-control w-75">
                </div>
            </div>
            <div class="col-md-4 ">
                <div class="mb-4">
                    <label for="supertype" class="form-label">Choisissez son SuperType :</label>
                    <select id="supertype" name="supertype" class="form-select w-75">
                        <option value="Pokémon">Pokémon</option>
                        <option value="Trainer">Entraineur</option>
                        <option value="Energy">Énergie</option>
                    </select>
                </div>
                <div>
                    <label for="rarete" class="form-label">Rareté du pokemon :</label>
                    <input type="text" name="rarete" id="rarete" class="form-control w-75">
                </div>
            </div>
            <div class="col-md-2 ms-3">
                <button type="submit" class="btn btn-primary">Envoyer</button>
            </div>
        </form>
        <div class="d-flex flex-wrap gap-3 justify-content-center mt-5">
            {%if lesPokemons|length == 0 %}
                <div class="text-center">
                    <img src="../static/image/iconeVide.png" alt= "Aucun résultat" class="w-25"/>
                    <p class ="fs-2 fw-bold mt-3"> Aucun résultat  🥀</p>     
                </div>
            {% else %}
                {%for ligne in lesPokemons %}
                    <div class="card" style="width: 16rem;">
                        <img src="../static/image/image.jpeg" class="card-img-top" alt="Image Pokemon">
                        <div class="card-body">
                            <h5 class="card-title">{{ligne["name"]}}</h5>
                        </div>
                        <ul class="list-group list-group-flush">            
                            {% if ligne["types"] is not none %}
                                <li class="list-group-item">Type : {{ ligne["types"] | replace("[", "") | replace("]", "") | replace("'", "") }}</li>
                            {% endif %}
                            {% if ligne["set_num"] is not none %}
                                <li class="list-group-item">Valeur : {{ ligne["set_num"] }}</li>
                            {% endif %}
                            {% if ligne["rarity"] is not none %}
                                <li class="list-group-item">Rareté : {{ ligne["rarity"] }}</li>
                            {% endif %}

                            <li class="list-group-item"> <button type="submit" class="btn btn-primary"><a href="{{url_for('collection.ajouter ',id_pokemon=ligne["id"])}}" class="text-white text-decoration-none">Ajouter à la collection</a></button></li>
                        </ul>
                        
                    </div>
                {%endfor%}
            {% endif %}   
        </div>
    </div>
    
{% endblock %}
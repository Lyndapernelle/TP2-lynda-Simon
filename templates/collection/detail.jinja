{% extends "_base.jinja" %}

{% block contenu %}
   <div class="row justify-content-center  container mt-5">
        <div class="col-md-7">
            <img src="..{{lePokemon["photo"]}}" class="w-75" alt="Image du pokemon">
        </div>
        <div class="col-md-5">
            <div class="d-flex align-items-center fs-3">
                <ul class="list-group mt-3">
                    <h3 class="mb-3"> {{lePokemon["name"]}}</h3>
                    <li class="list-group-item"><strong>Rareté :</strong> {{lePokemon["rarity"]}} </li>
                    <li class="list-group-item"><strong>Coût :</strong> {{lePokemon["cost"]}} </li>
                    <li class="list-group-item"><strong>Date d'ajout :</strong> {{lePokemon["added_date"]}} </li>
                    <li class="list-group-item"><strong>SuperType :</strong> {{lePokemon["supertype"]}} </li>
                    <li class="list-group-item"><strong>Statut :</strong>
                        <span class="badge bg-{% if lePokemon["status"] == 'disponible' %}success{% else %}warning{% endif %}">
                        {{ lePokemon["status"] }}
                        </span>
                    </li>
                    <li class="list-group-item fs-4"><strong>Date d'obtention :</strong> {{lePokemon["added_date"]}} </li>
                    <li class="list-group-item"><strong>Condition :</strong> {{lePokemon["condition"]}} </li>
                </ul>
            </div>
            {% if session["courriel"] == 'admin@garneau.ca' or 'id' in session == lePokemon["id_collectionneur"]%}  
                <form method="GET" class="mt-3" action="{{url_for('collection.modifier_carte',id_pokemon = lePokemon["id"])}}">
                    <button type="submit" class="btn btn-primary">Modifier la carte</button> 
                </form>
            {% endif %}
        </div>

   </div>
   
   

{% endblock %}

{% extends "_base.jinja" %}
 
{% block contenu %}
    <div class="row justify-content-center  container mt-5">
        <div class="d-flex align-items-center fs-3">
            <h3 class="mb-3"> {{lePokemon["name"]}}</h3>
            <ul class="list-group mt-3">
                <li class="list-group-item"><strong>Rareté :</strong> {{lePokemon["courriel"]}} </li>
                <li class="list-group-item" name="prix"><strong>Coût :</strong> {{lePokemon["prix_offert"]}} </li>
                <li class="list-group-item"><strong>Date d'ajout :</strong> {{lePokemon["date"]}} </li>     
            </ul>    
            <form method="POST" class="mt-3" action="{{url_for('collection.ajout_offre',id_carte = lePokemon["id_offre"] )}}">
                <label for="statut" class="form-label">statut :</label>
                <select name="statut" id="statut_carte" class="form-select w-50"> 
                    <option value="en attente">En attente</option>
                    <option value="acceptée">acceptée</option>
                    <option value="refusée">Refusée</option>
                </select>             
                <button type="submit" class="btn btn-primary">Mettre un offre</button> 
            </form>    
        </div>
    </div>
{% endblock %}
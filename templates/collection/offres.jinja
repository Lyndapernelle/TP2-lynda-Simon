{% extends "_base.jinja" %}
 
{% block contenu %}
    <div class="d-flex align-items-center fs-3">
        <img src="{{offres["photo"]}}" class="card-img-top" alt="Image Pokemon">
        <h3 class="mb-3"> {{offres["name"]}}</h3>
        <ul class="list-group mt-3">
            <li class="list-group-item"><strong>Rareté :</strong> {{offres["courriel"]}} </li>
            <li class="list-group-item"><strong>Coût :</strong> {{offres["prix_offert"]}} </li>
            <li class="list-group-item"><strong>Date d'ajout :</strong> {{offres["date"]}} </li>
            <label for="statut" class="form-label">statut :</label>
            <select name="statut" id="statut_carte" class="form-select w-50"> 
                <option value="en attente">En attente</option>
                <option value="acceptée">acceptée</option>
                <option value="refusée">Refusée</option>
            </select>
        </ul>
        <form method="POST" class="mt-3" action="{{url_for('collection.offres', offre_id = offres["id_carte"] )}}">
            <button type="submit" class="btn btn-primary">Modifier la carte</button> 
        </form>
    </div>

{% endblock %}
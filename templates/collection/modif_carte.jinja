{% extends "_base.jinja" %}
 
{% block contenu %}
    <section class="row justify-content-between mt-4">
        <div class="col-md-5 mt-2">
            <img src="{{ajouterPokemon["photo"]}}" class="card-img-top img-fluid" alt="Image du pokemon">
        </div>  
        <form method="POST" class="col-md-6 align-items-center " enctype="multipart/form-data" action="{{ url_for('collection.modifier_carte',coll_id = ajouterPokemon.id) }}">
            <section class="fs-4 ">
                <p class="mb-3 mt-3 fs-4 fw-semibold">Nom du Pokemon : {{ajouterPokemon["name"]}}</p>

                <div class="mb-2">
                    <label for="condition_carte" class="form-label">Condition : </label>
                    <select name="condition" id="condition_carte" class="form-select w-50"> 
                        <option value="presque neuve"> presque neuve </option>
                        <option value=" légèrement usée">  légèrement usée </option>
                        <option value="modérément usée"> modérément usée </option>
                        <option value="très usée"> très usée </option>
                        <option value="abîmée"> abîmée </option>
                    </select>
                    <p class="text-danger fs-5">{{message_condition}}</p>
                </div>
                <div class="mb-2">
                    <label class="form-label"> Statut de la carte : </label>
                    <select name="statut" id="statut-carte" class="form-select w-50"> 
                        <option value="disponible">Disponible</option>
                        <option value="recherchée">Recherchée</option>
                    </select>
                    <p class="text-danger fs-5">{{message_statut}}</p>
                </div>
                 <div class="mb-2">
                    <label class="form-label">Coût : </label>
                    <input type="text" class="form-control w-50" name ="cout" value="{{ ajouterPokemon["cost"] }}"></input>
                    <p class="text-danger fs-5">{{message_cout}}</p>
                </div>
                <div>
                    <label for="image" class="form-label"> Changer l'image : </label>
                    <input type="file" name="image" id="image" class=" form-control w-50 {%if message_image %}is-invalid{%endif%}"/>
                    <p class="text-danger fs-5">{{message_image}}</p>
                </div>
            </section>          
            <button type="submit" class="btn btn-primary">Modifier la carte</button>
        </form>
    </section>
   
      
 
{% endblock %}

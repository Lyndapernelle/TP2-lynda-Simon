{% extends "_base.jinja" %}
 
{% block contenu %}
    <section class="row justify-content-between">
        <div class="col-md-4 mt-2">
            <img src="static/image/image.jpeg" class="card-img-top img-fluid" alt="Image Pokemon">
        </div>  
        <form method="POST" class="col-md-6 align-items-center" action="{{ url_for('collection.ajouter') }}">
            <section class="fs-4">
                <div class="mb-2">
                    <label class="form-label">Nom du Pokemon : </label>
                    <input type="text" class="form-control w-50" name="nom_pokemon" value ="{{ ajouterPokemon["name"] }}"></input>
                </div>
                <div class="mb-2">
                    <label class="form-label">Type : </label>
                    <input type="text" class="form-control w-50" name="type_pokemon" value ="{{ ajouterPokemon["types"] | replace("[", "") | replace("]", "") | replace("'", "") }}"></input>
                </div>
                <div class="mb-2">
                    <label class="form-label">Valeur : </label>
                    <input type="text" class="form-control w-50" name ="num_pokemon" value="{{ ajouterPokemon["set_num"] }}"></input>
                </div>
                <div class="mb-2">
                    <label class="form-label">Rareté : </label>
                    <input type="text" class="form-control w-50" name="rarete_pokemon" value="{{ ajouterPokemon["rarity"] }}"></input>
                </div>
            </section>
            <section class="fs-4">
                <div class="mb-2">
                    <label for="condition_carte" class="form-label">La condition : </label>
                    <select name="condition" id="condition_carte" class="form-select w-50"> 
                        <option value="presque neuve"> presque neuve </option>
                        <option value=" légèrement usée">  légèrement usée </option>
                        <option value="modérément usée"> modérément usée </option>
                        <option value="très usée"> très usée </option>
                        <option value="abîmée"> abîmée </option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label"> Coût de la carte : </label>
                    <input type="number" class="form-control w-50" name="cout"></input>
                </div>
                <div class="mb-2">
                    <label class="form-label"> Statut de la carte : </label>
                    <input type="text" class="form-control w-50" name="statut"/>
                </div>
            </section>
            <div class="text-center">
                <button type="submit" class="btn btn-primary"><a href="{{url_for('collection.ajouter',id_pokemon=ligne["id"])}}" class="text-white text-decoration-none">Ajouter à la collection</a></button>
            </div>
        </form>
    </section>
   
      
 
{% endblock %}
